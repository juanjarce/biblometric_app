 affiliation = {Halliday, S (Corresponding Author), Univ Adelaide, Sch Psychol, Adelaide, Australia.
Halliday, Sarah; Lavis, Tiffany; Callaghan, Peta; Chur-Hansen, Anna, Univ Adelaide, Sch Psychol, Adelaide, Australia.},
 affiliations = {Adelaide University; University of Adelaide},
 author = {Halliday, Sarah and Lavis, Tiffany and Callaghan, Peta and Chur-Hansen,
Anna},
 author-email = {sarah.halliday@adelaide.edu.au},
 cited-references = {Al-Abri A, 2025, EDUC INF TECHNOL, V30, P17447, DOI 10.1007/s10639-025-13484-x.
