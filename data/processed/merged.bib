@article{merged1322,
 abstract = {Information literacy is evolving alongside the development of tools that
utilize generative artificial intelligence (AI). Understanding how
researchers' internal and external biases can impact the searching that
they do, as well as the searching that our students undertake, helps
create stronger researchers and a more literate student population. This
article examines areas of algorithmic bias in different platforms, from
generative AI tools to research tools, and offers insight on addressing
bias in an information literacy classroom by using and adapting the
Association of College and Research Libraries ``Framework for
