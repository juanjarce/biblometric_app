@article{merged1485,
 abstract = {The utilization of ChatGPT within the realm of higher education opens
new horizons for the development of creative thinking. The primary aim
of this empirical investigation is to explore the potential of ChatGPT
employment in stimulating and augmenting creativity, as well as to
examine students' perceptions and evaluations of ChatGPT's potential,
incorporating a strengths, weaknesses, opportunities, and threats
analysis within this context. The study engaged 300 freshmen students.
The instruments employed included the Torrance Test of Creative Thinking
and a specifically devised Generative AI Potential Scale. The research
revealed a significant enhancement in the creative output of students in
the experimental group after the implementation of ChatGPT. Students in
the experimental group expressed a positive perception of the generative
artificial intelligence capabilities postusage. The article elucidates
the practical value of ChatGPT employment in enhancing student
creativity and proffering innovative teaching methodologies to
educational institutions.},
