@article{merged1863,
 abstract = {The emergence of generative artificial intelligence has sparked global
reflection on the essence of education in the context of intelligent
environments. The United Nations Educational, Scientific and Cultural
Organization emphasizes the concept of ``people-oriented{''} intelligent
education in the framework of teacher and student artificial
intelligence capabilities, focusing on the uniqueness and preciousness
of human individuals. This study takes the ``15 National High School
Information Technology Quality Courses{''} as an example, and uses lag
sequence analysis and content analysis to explore the behavioral
sequence influence and internal influence mechanism between teacher
discourse and student thinking development in the classroom. Research
has found that teacher discourse in junior high school information
technology classrooms highlights student centeredness and knowledge
orientation; There is a significant relationship between teacher
discourse and student thinking development; The behavior sequence of
teacher discourse on students' thinking development presents complexity
and dynamism. Based on the research findings, this study proposes
various teaching methods such as blended learning, enriching classroom
interactive content and methods, and deeply integrating intelligent
technology and information technology course content to implement
students' higher-order thinking abilities, promote efficient
teacher-student interaction activities in an intelligent education
environment, and achieve sustainable development of intelligent
education.},
 address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
