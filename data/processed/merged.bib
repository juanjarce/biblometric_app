@article{merged1141,
 abstract = {Generative Artificial Intelligence (GenAI) represents a transformative
technology with vast implications for higher education institutions
related to enhancing the teaching and learning experience while posing
numerous challenges for unqualified and unequipped faculty members and
students in using the innovative technology and jeopardising the
academic integrity of educational assessments. Thus, much has been done
to either combat or utilise this new technology in classrooms, largely
within specific domains and without a well-defined strategy. This paper
proposes a three-pronged strategy for deploying GenAI within an
educational institution. The strategy pillars are faculty members'
training, curriculum analysis and integration, and the institution's
governance policy creation. This three-fold strategy for deploying GenAI
in an educational institution constitutes a comprehensive framework
proposal allowing institutions to integrate, harness and optimise the
power of this innovative technology while mitigating the potential
risks, enforcing academic honesty and originality, and achieving
proficiency for faculty members and students alike in using GenAI for
academics, research, and in the workplace.},
