@article{merged1667,
 abstract = {This article analyses how South African academics use and perceive the
usage of GenAI in Higher Education in South Africa. In the context of a
highly unequal, multi-lingual society, there is a dire need to enable
epistemological access for all students. Could artificial intelligence
with its transformative potential offer solutions or alternatively
compound the problem? The article is based on a thematic analysis of
interviews with 16 academics from two universities and complements our
study which surveyed South African students' AI usage. The findings
reveal that despite the interactive potential of such AI tools to assist
with student learning, the seeming `instant perfection' of AI generated
work discourages students from engaging in the difficult task of
adopting academic identities. We proceed to show how usage of GenAI
tools differs amongst academics based on their different understandings
of the purpose of the university.},
