 journal = {IEEE Transactions on Dependable and Secure Computing},
 keywords = {Accuracy; Additives; Data mining; Diffusion models; Distortion; Frequency-domain analysis; Gaussian distribution; Generative image steganography; Steganography; Vectors; Visualization; additive sampling; deterministic guided; diffusion model},
 month = {Nov},
