@article{merged1056,
 abstract = {The purpose of this study is to critically review the effect of
generative artificial intelligence (GAI) tools on higher education and
research in the tourism and hospitality (TH) field. This manuscript
identifies capabilities and implications of these GAI applications
through a theoretical lens. GAI adoption in TH education can facilitate
personalized learning experiences, enhance the technological competence
of students, and foster a more diverse and inclusive learning
environment. For academic research, GAI-enabled technologies may
revolutionize data collection, analysis, and writing in a myriad of
ways. However, there are multiple ethical and legal concerns associated
with adoption that must be considered. At the end of this paper, we
propose ten discussion questions aimed at stimulating conversation about
adoption of GAI tools in TH education and research.},
