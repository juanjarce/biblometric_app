@article{merged1055,
 abstract = {Generative AI is rapidly emerging as a mainstream or general purpose
technology that non-specialists may use with the aim of enhancing
accessibility although many will not have the lived experience or
expertise to evaluate whether this sufficiently meets the diverse needs
of others. This is particularly critical for educators, as disabled
students already report inconsistencies with existing technological and
institutional supports. To date, there have been relatively few efforts
