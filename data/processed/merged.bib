Oc, Yusuf, City Univ London, London, England.
Gonsalves, Chahna, Kings Coll London, London, England.
Quamina, La Toya, Westminster Business Sch, London, England.},
 affiliations = {City St Georges, University of London; University of London; King's
College London; University of Westminster},
 author = {Oc, Yusuf and Gonsalves, Chahna and Quamina, La Toya},
