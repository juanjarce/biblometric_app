@article{merged1517,
 abstract = {Since the widespread availability of generative Artificial Intelligence
(AI) Chatbots, colleges and universities have been grappling with their
impact on higher education. The attitudes toward AI Chatbots vary
greatly, but most studies focus on specific campus populations. As such,
we designed and conducted a survey to capture use and perception of AI
Chatbots across the three primary campus populations: faculty (N = 77),
staff (N = 110), and students (N = 223). While all three campus
populations had similar scores regarding being first adopter of new
technology, they had statistically significantly different scores for
seven other 5-point Likert scales regarding AI Chatbot use and
perception. Despite the differences in their use and perception,
subsequent textual analysis indicates that the campus populations share
similar concerns about AI Chatbot accuracy, bias, and technology
dependency. As such, we provide insight into the attitudes across campus
after a sudden and significant technological innovation disrupts
educational practices.},
