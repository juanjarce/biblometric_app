 doi = {10.1109/TELE66816.2025.11211994},
 keywords = {Chatbots; Encoding; Generative AI; IT students; Large language models; Learning (artificial intelligence); Market research; Reflection; Surveys; Training; Transformers; artificial intelligence; generative artificial intelligence; large language model; teaching coding skills},
 month = {Sep.},
 pages = {221-226},
 title = {An Analysis of It Students' Attitudes Toward the Use of the Chatgpt Large Language Model in the Learning Process: Identifying Potential Concerns},
 year = {2025}
}

@inproceedings{merged125,
 abstract = {This article focuses on the empowerment of artificial intelligence in university teaching, providing an in-depth and systematic analysis of the tremendous potential of cutting-edge technologies such as generative language models, multimodal large models, and knowledge graphs in innovating teaching models and comprehensively enhancing students' abilities. The rapid development of AI technology has prompted a profound transformation in traditional educational models, gradually shifting from a single teacher-centered teaching model to a personalized, intelligent, and diverse interactive model. Innovative applications have been realized in key scenarios such as classroom teaching, practical training, and academic competitions, opening up new paths for the improvement of university education quality. At the same time, the article also points out that the journey of AI-empowered university teaching is not smooth, facing many complex and critical challenges in practical applications. The aim of this article is to provide a solid theoretical basis for the continuous innovation and development of university education in the AI era, vigorously promoting university education to a new stage of higher quality and more vitality, and cultivating more innovative, composite, and high-quality talents to meet the needs of the new era.},
 author = {Bu, WenJuan and Zhao, YunTian and Shu, Hui and Xie, JiangTao},
 booktitle = {2025 5th International Conference on Artificial Intelligence and Education (ICAIE)},
 doi = {10.1109/ICAIE64856.2025.11158567},
 keywords = {AI; Analytical models; Artificial Intelligence; Artificial intelligence; Education; Generative Language Models; Knowledge Graphs; Knowledge graphs; Multimodal Large Models; Solids; Systematics; Technological innovation; Training},
 month = {May},
 pages = {485-490},
 title = {Opportunities and Challenges of AI Empowerment in University Teaching},
 year = {2025}
}

@inproceedings{merged126,
 abstract = {With its use increasingly pervading the learning space in higher education, Generative Artificial Intelligence (GenAI) tools are an inevitable resource that can contribute to the digital milieu of Higher Education. Necessitate by an inevitable need to engage with the GenAI tools in teaching and learning, this paper investigates how we may tap on GenAI response to mathematical problems as a potential resource for learning. Instead of solving the problems firsthand, we harness the GenAI tools for their near-instant solutions to mathematical question prompts that included guidance on the steps provided. We then performed an evaluation of the solutions provided. We find that our approach on the use of GenAI tools, along with the post solution evaluation process, has significant potential in contributing to active learning and critical thinking. More studies can be done to ascertain these benefits with research involving student participation.},
 author = {Ong, Jade and Ho, Chee Kit and Yan Koh, Yit and Kok, Chiang Liang},
 booktitle = {2024 IEEE 17th International Symposium on Embedded Multicore/Many-core Systems-on-Chip (MCSoC)},
 doi = {10.1109/MCSoC64144.2024.00011},
 issn = {2771-3075},
 keywords = {Active learning; Critical thinking; Dynamic scheduling; Education; Engineering; Evaluation; Generative AI; Generative Artificial Intelligence (GenAI); Higher Education; Learning; Learning (artificial intelligence); Mathematics; Multicore processing; Problem solving; Reliability; Teaching},
 month = {Dec},
 pages = {5-10},
 title = {Harnessing the Power of GenAI tools: Evaluating Response as an Approach to Learning},
 year = {2024}
}

@inproceedings{merged127,
 abstract = {This study presents the results of an analysis on the perception of secondary education teachers in the Dominican Republic regarding the use of emerging technologies, including Artificial Intelligence (AI), in their classroom practices. It also identifies the barriers and ethical risks associated with their integration. An online survey was administered to a sample of 754 teachers, using a questionnaire validated by expert judgment and with high reliability ${(\alpha=0.941)}$. The results showed a high level of adoption of technological tools, with the most commonly used being Quizizz, ChatGPT, Padlet, and Kahoot!. Gamification was perceived as the tool with the greatest benefits for student learning and motivation, while generative AI text raised concerns about its potential negative impact on cognitive development. The lack of access to equipment and resources, as well as the need for teacher training, were identified as the main barriers to implementation. Additionally, ethical concerns related to data privacy and security, especially in the case of generative AI text, were evident. The findings suggest the need for further reflection and discussion on the ethical risks of these technologies within the educational community, as well as the design of policies and teacher training programs that promote their effective and responsible use.},
 author = {Santana-Soriano, Edwin},
 booktitle = {2025 Institute for the Future of Education Conference (IFE)},
 doi = {10.1109/IFE63672.2025.11024985},
 keywords = {Artificial Intelligence in Education; Chatbots; Data privacy; Educational Ethics; Emerging Technologies; Ethics; Gamification; Generative AI; Media; Media Literacy; Reflection; Reliability; Security; Surveys; Training},
 month = {Jan},
 pages = {1-7},
 title = {Perception of the Integration of Artificial Intelligence and Other Emerging Technologies in Dominican Education from an Ethical Perspective},
 year = {2025}
}

@inproceedings{merged128,
 abstract = {Introduction: AI tools can aid most of the processes in higher education, providing immediate and personalized feedback, improve research and innovation strategies, preparing our students for the future job market, by strengthening both disciplinary and soft competencies. Healthcare professionals require training in critical thinking as it drives most of the decisions made in patient care. The objective of this study was to compare the acquisition of theoretical knowledge, the development of critical thinking and student engagement before and after the use of a generative artificial intelligence tool. Methodology: Cross-sectional, mixed, quasi-experimental comparative study design. We used theoretical knowledge, critical thinking, and involvement questionnaires before and after the use of the Noodle Factory AI tool. We used Noodle Factory AI tool for learning activities in a 5-week period. The IA tool provided immediate personalized feedback for each student. Results: Both Vigor and Absorption domains in the Engagement and theoretical knowledge questionnaires provided significant differences after the use of the AI tools. Critical thinking did not show significant change, possibly due to the short period of the study. Conclusion: We obtained significant differences in the 5-week period of AI tool use, which shows the advantage of including these tools. The transformative shift towards efficient administration of courses, enhanced personalized learning and strengthened research skills.},
 author = {De Los Angeles Segura-Azuara, Nancy and De Jesus Garza-Arriaga, Fernando and Guzman-Segura, Jose Guillermo},
 booktitle = {2025 Institute for the Future of Education Conference (IFE)},
 doi = {10.1109/IFE63672.2025.11024693},
 keywords = {Absorption; Artificial intelligence; Decision making; Learning (artificial intelligence); Medical services; Optimization; Production facilities; Technological innovation; Testing; Training; artificial intelligence (AI); critical thinking; feedback; innovative education},
 month = {Jan},
 pages = {1-8},
 title = {Enhanced Learning with Artificial Intelligence: A Comparative Study in Medical Students},
 year = {2025}
}

@inproceedings{merged129,
 abstract = {This review examines the utilization of Generative Artificial Intelligence (GAI) in classroom instructions, emphasizing its transformative potential in education. After reviewing 23 relevant articles, we identified three themes: application advantages, possible risks, and future paths. Specifically, GAI has the potential to facilitate personalized learning, promote communication, and promoting education equity. However, concerns over content validity, ethical issues, and the risk of diminished innovation necessitate careful consideration. Additionally, prior literature suggests improving instructional evaluation methods, enhancing AI literacy, and addressing ethical challenges to maximize GAI's benefits and drive continuous educational innovation.},
 author = {Shi, Yuxuan and Huang, Wen and Sang, Yijing},
 booktitle = {2024 4th International Conference on Educational Technology (ICET)},
 doi = {10.1109/ICET62460.2024.10868958},
 keywords = {Educational technology; Ethics; Generative AI; Learning (artificial intelligence); Reviews; Technological innovation; classroom instruction; generative artificial intelligence; literature review},
 month = {Sep.},
 pages = {419-422},
 title = {A Narrative Review of Utilizing Generative Artificial Intelligence in Classroom Instructions},
 year = {2024}
}

@inproceedings{merged130,
 abstract = {This paper proposes a personalized learning system based on generative artificial intelligence, which aims to improve students' learning efficiency and interest through adaptive learning paths and content recommendations. The system integrates advanced artificial intelligence technologies such as GAN and VAE to achieve deep customization and dynamic adjustment of the learning process. First, the GAN model is used to generate personalized learning resources, including courseware, exercises and learning paths, which are dynamically adjusted according to students' knowledge mastery and learning styles. VAE is used to construct a latent space representation of students' learning status and further optimize the personalized recommendation of learning content. To verify the effectiveness of the system, this paper conducted many simulation experiments. By analyzing the learning behavior data of different student groups, the system's performance in personalized recommendation and learning progress adaptation was evaluated. The experimental results show that the personalized learning system based on generative artificial intelligence has significant advantages in improving students' learning effects, shortening learning time, and increasing learning participation. Specific data show that the recommendation accuracy of the system reaches 92%, the learning efficiency is improved by 15%, and the student satisfaction is 20% higher than the traditional learning model.},
 author = {Zhou, Chu},
 booktitle = {2025 IEEE International Conference on Electronics, Energy Systems and Power Engineering (EESPE)},
 doi = {10.1109/EESPE63401.2025.10986914},
 keywords = {Accuracy; Courseware; Data models; GAN; Generative AI; Learning (artificial intelligence); Learning systems; Personalized learning system; Power engineering; Real-time systems; Recommender systems; System performance; VAE; artificial intelligence},
 month = {March},
 pages = {1004-1008},
 title = {Design and Implementation of Personalized Learning System Based on Generative Artificial Intelligence},
 year = {2025}
}

@inproceedings{merged131,
 abstract = {With the rapid advancement of Artificial Intelligence Generated Content (AIGC) technology, its potential applications in education are becoming increasingly broad. Currently, practical operation courses in higher education institutions face various issues such as low classroom interaction, uneven student development, lack of resources, and imperfect evaluation systems. AIGC technology, with its unique advantages, has brought new hope for addressing these challenges. This paper explores the feasibility of applying AIGC technology in practical operation courses in higher education institutions, based on the existing problems in teaching. It proposes a " Teacher-Student-AIGC " teaching strategy that integrates AIGC for these courses. Taking the course "Image Processing Technology" as an example, the paper specifically demonstrates the innovative application and implementation strategy of AIGC technology in practical operation teaching. The aim is to provide a practical reference plan for the teaching reform of practical courses in higher education institutions.},
 author = {Chen, Liting and Pan, Ruoqi and Li, Manjia and Ma, Shiming},
 booktitle = {2025 11th International Conference on Education and Training Technologies (ICETT)},
 doi = {10.1109/ICETT66247.2025.11137106},
 keywords = {"Teacher-Student-AIGC" Teaching Model; AIGC; Data privacy; Education; Ethics; Faces; Generative AI; Hands; Image processing; Navigation; Practical Operation Course; Technological innovation; Training},
 month = {May},
 pages = {45-49},
 title = {Exploration of the Application of Generative Artificial Intelligence in Practical Operation Courses in Colleges and Universities—Taking ‘Image Processing Technology’ as an Example},
 year = {2025}
}

@article{merged132,
 abstract = {The modern educational landscape is frequently crossed and sometimes even deeply reshaped by novel digital technologies, which promise to disclose new paths for teaching, learning, and research. Among a significant number of engaging approaches, the concept of intelligence augmentation (IA) is emerging as one of the most transformative since it involves a complementary partnership between human and artificial intelligence (AI) [1]. The aim is as ambitious as intriguing, since human intelligence’s strengths (e.g., judgment, ethics, and practical knowledge) can be relevantly boosted when augmented with the tasks that AI typically excels at (e.g., computation, prediction, and data-driven analysis) [1].},
 author = {Zappatore, Marco and Wang, Minjuan and Dede, Chris and Li, Xuefan},
 doi = {10.1109/TLT.2025.3639317},
 issn = {1939-1382},
 journal = {IEEE Transactions on Learning Technologies},
 keywords = {Artificial intelligence; Collaboration; Education; Ethics; Generative AI; Psychology; Reflection; Reviews; Robots; Special issues and sections},
 pages = {1112-1115},
 title = {Guest Editorial: Special Issue Intelligence Augmentation and the Future of Education: Transforming Learning Landscapes Across Modalities and Lifecycles},
 volume = {18},
 year = {2025}
}

@inproceedings{merged133,
 abstract = {The integration of generative artificial intelligence (AI) tools, particularly large language models (LLMs), into higher education presents both opportunities for pedagogical innovation and challenges to academic integrity. While recent initiatives, such as the European Union's AI Act and UNESCO's Recommendation on the Ethics of Artificial Intelligence, have provided frameworks for ethical AI adoption, their practical implementation at the institutional level remains uneven. This study investigates how university faculty perceive the ethical implications of AI use in academic environments. Conducted as part of the EmpowerAI Erasmus+ project, a structured focus group involving 21 lecturers from the Technical University of Sofia in Bulgaria explored faculty staff attitudes toward AI's role in areas such as critical thinking, authorship, fairness, access, and privacy. Through thematic analysis, the study identifies emerging tensions between innovation and responsibility, and between equitable access and academic rigor. The findings underscore the need for context-sensitive institutional policies and educator training on AI ethics. The paper aims to contribute empirical evidence to the growing body of literature on responsible AI integration in higher education and informs the co-creation of actionable ethical guidelines that reflect both regulatory expectations and academic values.},
 author = {Pavlova, Yoana and Slavov, Vladislav},
 booktitle = {2025 60th International Scientific Conference on Information, Communication and Energy Systems and Technologies (ICEST)},
 doi = {10.1109/ICEST66328.2025.11098253},
 issn = {2603-3267},
 keywords = {AI Act; AI literacy; AIinED; Artificial intelligence; Erasmus+ EmpowerAI project; Ethics; Generative AI; Guidelines; Large language models; Plagiarism; Privacy; Regulation; Technological innovation; Training; academic integrity; ethics of AI in education; focus groups; generative AI; higher education policy; large language models},
 month = {June},
 pages = {1-4},
 title = {Exploring the Ethical Use of AI Technologies/Applications in Academic Environments},
 year = {2025}
}

@inproceedings{merged134,
 abstract = {This study focuses on the usage of online programming platforms and generative artificial intelligence (GAI) in the programming education of future Chinese engineers. Through a survey of 659 students from different engineering majors, a descriptive-quantitative-correlational research design was adopted to analyze the engagement of students from different disciplines with these tools and the relationship between tool usage and learning outcomes. The research findings show that the usage frequencies of both online programming platforms and GAI are “sometimes”, and there are significant differences in usage frequencies among different disciplines. Students majoring in computer and mechanical engineering have relatively high usage frequencies, while those majoring in electronics and civil engineering have lower usage frequencies. Meanwhile, there is a significant positive correlation between the engagement in the use of online programming platforms and GAI. This research provides references for the curriculum design of programming education, helps to optimize the allocation of educational resources, and promotes the innovative development of programming education.},
 author = {Yang, Kaiwen and Wang, Jingyi and Lu, Sifang and Liu, Qiyu and Cheng, Yuhao and Xia, Xiaoyu and Gao, Tianjiao and Wu, Jialin and Dong, Jiajun},
 booktitle = {2025 5th International Conference on Artificial Intelligence and Education (ICAIE)},
 doi = {10.1109/ICAIE64856.2025.11158705},
 keywords = {Civil engineering; Correlation; Education; Generative AI; Mechanical engineering; Online programming platforms; Programming profession; Resource management; Surveys; correlation; disciplinary differences; generative artificial intelligence; non-computer science major; programming education},
 month = {May},
 pages = {439-444},
 title = {Research on the Application of Online Programming Platforms and Generative Artificial Intelligence in the Programming Education of Prospective Chinese Engineers},
 year = {2025}
}

@inproceedings{merged135,
 abstract = {The rapid advancement of generative artificial intelligence (AIGC) tools presents both opportunities and challenges for writing education in higher education. Through a systematic literature review and coding analysis of empirical studies published internationally over the past five years, this study reveals the following findings: AIGC demonstrates significant utility in academic writing, language-learning writing, and creative writing, primarily applied for grammatical error correction, text refinement, and logical optimization. Student acceptance of AIGC exhibits polarized attitudes, with some acknowledging their positive contributions while others express concerns about potential adverse effects. The widespread adoption of AIGC has also raised academic ethical risks, such as academic misconduct. Additionally, educators must transition from knowledge transmitters to learning facilitators and technical mentors. Future research should prioritize longitudinal investigations into the long-term impacts of AIGC, interdisciplinary comparative studies, and the development of efficient human-AI collaborative models to foster innovation in writing pedagogy. This study provides theoretical foundations and practical guidance for the responsible application of AIGC in writing education.},
 author = {Hou, Dan and Tian, Kexin and Zhang, Wenyu and Li, Kexin and Cheng, Wei},
 booktitle = {2025 International Conference on Distance Education and Learning (ICDEL)},
 doi = {10.1109/ICDEL65868.2025.11193567},
 keywords = {AIGC; Academic integrity; Acceptance level; Education; Encoding; Error correction codes; Ethics; Generative AI; Optimization; Systematic literature review; Technological dependency; Technological innovation; Transmitters; Writing; Writing proficiency},
 month = {June},
 pages = {229-233},
 title = {Empowering Writing through AIGC in Higher Education: A Systematic Review},
 year = {2025}
}

@article{merged136,
 abstract = {Artificial intelligence (AI) agents can facilitate customized learning and deliver personalized student experiences. This article details pilot implementation of AI agents at a large public university, sharing insights and encouraging strategic use of AI in higher education.},
 author = {Dabirian, Amir and Badal, Matthew and Swarat, Su},
