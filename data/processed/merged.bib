@article{merged1805,
 abstract = {As medical educators grapple with the consistent demand for highquality
assessments, the integration of artificial intelligence presents a novel
solution. This how-to article delves into the mechanics of employing
ChatGPT for generating Multiple Choice Questions (MCQs) within the
medical curriculum. Focusing on the intricacies of prompt engineering,
we elucidate the steps and considerations imperative for achieving
targeted, high-fidelity results. The article presents varying outcomes
based on different prompt structures, highlighting the AI's adaptability
in producing questions of distinct complexities. While emphasizing the
transformative potential of ChatGPT, we also spotlight challenges,
including the AI's occasional ``hallucination{''}, underscoring the
importance of rigorous review. This guide aims to furnish educators with
the know-how to integrate AI into their assessment creation process,
heralding a new era in medical education tools.},
