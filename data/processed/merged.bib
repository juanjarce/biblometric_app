@article{merged1129,
 abstract = {The lack of training in generative AI (GenAI) among most medical
educators poses an important challenge. Recognizing this need, an
introductory session was created. A pre- and post-survey was distributed
to gain insights on the impact of the module and identify concerns about
GenAI in medical education. Scores for each statement were higher upon
completion of the module session. Feedback showed that the module was
well-received and reflected an openness to discuss the benefits and
challenges of GenAI. We need to help educators and learners how to use
GenAI tools judiciously and understand their benefits and limitations.},
