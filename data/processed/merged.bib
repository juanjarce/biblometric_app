@article{merged1286,
 abstract = {This article presents a proposal for seven guiding principles to create
protocols for integrating Generative Artificial Intelligence (GenAI)
into teaching and learning processes related to the development of
writing competencies in higher education. The study acknowledges GenAI
as a disruptive technology that poses ethical and pedagogical challenges
to education-particularly to writing instruction-given its capacity to
generate, restructure, and edit texts. The proposal stems from a
qualitative exploration that analyzed and interpreted twenty-six
academic articles published in Ibero-American journals between 2022 and
2024. These articles addressed GenAI integration in higher education,
its ethical challenges, and the perceptions of both faculty and
students. Through a hermeneutic approach and critical reading, recurring
categories and discursive patterns were identified; following an
inductive analysis, these patterns led to the formulation of the
guidelines. The study concludes that, given the growing use of GenAI by
students, educators should not opt for prohibition, but rather design
strategies for a pedagogical, critical, ethical, and creative adoption.
This proposal is preliminary, flexible, and subject to revision based on
each specific educational context.},
