 keywords = {Engineering students; Focusing; Generative AI; Guidelines; Hands; Instruments; Plagiarism; Reliability; Surveys; Training; engineering education; generative artificial intelligence; student perceptions; technology adoption},
 month = {July},
 pages = {1-6},
 title = {How Do Engineering Students View And Use Generative AI For Learning? Exploring Their Habits, Beliefs, And Attitudes},
