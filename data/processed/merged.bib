@article{merged1161,
 abstract = {This study investigates the adoption and use of generative artificial
intelligence (GenAI) among students in higher education (N = 756).
Drawing on a mixed-methods approach, the research reveals significant
disparities in GenAI uptake, influenced by field of study, gender, and
academic pathway. The study also highlights the perceived benefits of
GenAI, notably its capacity to support personalized learning and enhance
study organization. However, it also raises ethical concerns and notes
the risk of cognitive overreliance. The findings underscore the need for
targeted strategies to ensure a balanced, inclusive, and responsible
integration of GenAI within higher education institutions.},
