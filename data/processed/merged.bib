@article{merged1726,
 abstract = {Purpose This practitioner article examines the integration of Generative
Artificial Intelligence (GAI) as a ``critical friend{''} in a
foundation-level English course at Bahrain Polytechnic. The study aims
to explore how GAI can enhance students' learning experiences while
addressing concerns about academic integrity and plagiarism in Higher
Education (HE). Design/methodology/approach In this intervention, 17
participants used GAI during class activities over a period of four
weeks, receiving real-time feedback and tailored support, and data were
collected through unstructured, non-participant classroom observations
of GAI interactions and learner reflections submitted via Padlet. A
thematic analysis approach was applied to identify emerging patterns.
Findings Thematic analysis of data revealed changes in classroom
dynamics, with quieter classrooms and decreased student-student and
student-teacher interactions. The results also highlight that while
students initially took longer to complete tasks using GAI, they adapted
and became more autonomous over time. Originality/value This study
contributes to the emerging body of work on GAI in EAP contexts by
offering insights into its responsible and ethical integration. It
highlights both the opportunities and challenges of GAI use, suggesting
ways educators can reduce the stigma surrounding GAI while promoting its
constructive role in enhancing learning in HE settings.},
 address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
