@article{merged1763,
 abstract = {ChatGPT chatbot powered by GPT 3.5 was released in late November 2022
but has been rapidly assimilated into educational and clinical
environments. Method: Insight into ChatGPT capabilities was undertaken
in an interview-style approach with the chatbot itself. Results: ChatGPT
powered by GPT 3.5 exudes confidence in its capabilities in supporting
and enhancing student learning in nuclear medicine and in supporting
clinical practice. ChatGPT is also self-aware of limitations and flaws
in capabilities and the risks these pose to academic integrity.
Conclusion: Further objective evaluation of ChatGPT capabilities in
authentic learning and clinical scenarios is required.},
