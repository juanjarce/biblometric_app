@article{merged1916,
 abstract = {This paper investigates the emerging integration of generative
artificial intelligence (GenAI) into various academic disciplines and
the implications for academic librarians. As GenAI capabilities expand
rapidly, higher education faculty are exploring ways to incorporate this
technology into teaching and learning. The paper reviews published
literature across three disciplines: art, English composition and
writing, and mathematics. Common themes emerge around using GenAI for
tasks such as brainstorming ideas, providing feedback, translation, and
accessibility support. However, the specific applications tend to align
with the core values and ways of thinking in each discipline. The paper
argues that for academic librarians to effectively support students and
faculty, they need to understand these disciplinary contexts. The paper
provides an overview of the current disciplinary conversations to inform
how academic librarians can adjust their work accordingly.},
